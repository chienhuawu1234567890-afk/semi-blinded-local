# Simulation of utility and assignment disclosure
# with participant-specific near-permutation transition matrices.
#
# Save as: semi_blinded_utility_confidentiality_revised.R
#
# Outputs:
#   simulation_utility.csv
#   simulation_disclosure.csv
#   simulation_joint_decision.csv
#
# Requires the recommended R package "nnet".

if (!requireNamespace("nnet", quietly = TRUE)) {
  stop("Please install the 'nnet' package.")
}

set.seed(20260925)

# Illustrative thresholds. Prespecify appropriate values for the trial.
simulation_criteria <- list(
  max_variance_ratio = 1.50,
  min_coverage = 0.93,
  max_W_accuracy = 0.60,
  max_W_high95 = 0.05
)

r <- rep(1 / 3, 3)
contrast <- c(-1, 0, 1)

softmax_rows <- function(logp) {
  row_max <- apply(logp, 1, max)
  z <- exp(sweep(logp, 1, row_max, "-"))
  z / rowSums(z)
}

make_Q <- function(g, epsilon, max_condition = 100) {
  # P differs across participants.
  # H is a random column-stochastic matrix.
  # Q approaches P as epsilon approaches zero.
  repeat {
    permutation <- sample.int(g)
    P <- diag(g)[permutation, , drop = FALSE]

    H <- matrix(rexp(g * g), nrow = g)
    H <- sweep(H, 2, colSums(H), "/")

    Q <- (1 - epsilon) * P + epsilon * H
    condition <- kappa(Q, exact = TRUE)

    if (is.finite(condition) && condition <= max_condition) {
      return(list(Q = Q, condition = condition))
    }
  }
}

make_data <- function(n, means, epsilon, r) {
  g <- length(r)

  A <- sample.int(g, n, replace = TRUE, prob = r)
  Y <- rnorm(n, mean = means[A], sd = 1)

  T <- diag(g)[A, , drop = FALSE]
  W <- matrix(NA_real_, nrow = n, ncol = g)
  G <- integer(n)
  condition <- numeric(n)

  for (i in seq_len(n)) {
    mechanism <- make_Q(g, epsilon)
    Q <- mechanism$Q

    G[i] <- sample.int(g, 1L, prob = Q[, A[i]])
    Z <- diag(g)[, G[i]]

    W[i, ] <- as.vector(solve(Q, Z)) * Y[i]
    condition[i] <- mechanism$condition
  }

  list(
    A = A,
    Y = Y,
    T = T,
    W = W,
    G = G,
    condition = condition
  )
}

W_features <- function(W) {
  # All features are calculated from W alone.
  # Since Q is column-stochastic, rowSums(W) recovers Y.
  Y_from_W <- rowSums(W)

  denominator <- ifelse(
    abs(Y_from_W) > 1e-10,
    Y_from_W,
    NA_real_
  )

  normalized <- sweep(W, 1, denominator, "/")
  normalized[!is.finite(normalized)] <- 0

  data.frame(
    W1 = W[, 1],
    W2 = W[, 2],
    W3 = W[, 3],
    Y_from_W = Y_from_W,
    V1 = normalized[, 1],
    V2 = normalized[, 2],
    V3 = normalized[, 3]
  )
}

train_W_attacker <- function(
  means,
  epsilon,
  r,
  n_train = 10000L
) {
  # Training assignments are independent of evaluation trials.
  # At evaluation, the attacker receives W alone.
  training <- make_data(n_train, means, epsilon, r)

  features <- W_features(training$W)
  features$A <- factor(
    training$A,
    levels = seq_along(r)
  )

  nnet::multinom(
    A ~ .,
    data = features,
    trace = FALSE,
    decay = 0.001,
    maxit = 300
  )
}

predict_W <- function(model, W, g) {
  post <- predict(
    model,
    newdata = W_features(W),
    type = "probs"
  )

  post <- as.matrix(post)

  if (ncol(post) != g || nrow(post) != nrow(W)) {
    stop("The W-only prediction model returned an unexpected size.")
  }

  post <- pmax(post, 1e-12)
  post / rowSums(post)
}

posterior_outcome <- function(Y, means, r) {
  logp <- sapply(seq_along(r), function(a) {
    log(r[a]) +
      dnorm(Y, mean = means[a], sd = 1, log = TRUE)
  })

  softmax_rows(logp)
}

disclosure_metrics <- function(post, A, g) {
  n <- length(A)
  actual <- diag(g)[A, , drop = FALSE]

  selected <- post[cbind(seq_len(n), A)]
  maximum <- apply(post, 1, max)

  c(
    accuracy = mean(max.col(post) == A),
    logloss = mean(-log(pmax(selected, 1e-12))),
    brier = mean(rowSums((post - actual)^2)),
    high80 = mean(maximum >= 0.80),
    high95 = mean(maximum >= 0.95)
  )
}

fit_analysis <- function(contrib, r, contrast) {
  n <- nrow(contrib)
  Rinv <- diag(1 / r)

  mu_hat <- as.vector(Rinv %*% colMeans(contrib))

  V_hat <- Rinv %*%
    stats::cov(contrib) %*%
    Rinv / n

  estimate <- sum(contrast * mu_hat)

  se <- sqrt(
    as.numeric(
      t(contrast) %*% V_hat %*% contrast
    )
  )

  c(
    estimate = estimate,
    se = se,
    reject = as.numeric(
      abs(estimate / se) > qnorm(0.975)
    )
  )
}

one_trial <- function(
  n,
  means,
  epsilon,
  r,
  attacker,
  contrast
) {
  dat <- make_data(n, means, epsilon, r)
  g <- length(r)

  original <- fit_analysis(
    dat$T * dat$Y,
    r,
    contrast
  )

  released <- fit_analysis(
    dat$W,
    r,
    contrast
  )

  post_allocation <- matrix(
    rep(r, each = n),
    nrow = n
  )

  post_outcome <- posterior_outcome(
    dat$Y,
    means,
    r
  )

  post_W <- predict_W(
    attacker,
    dat$W,
    g
  )

  list(
    original = original,
    released = released,
    disclosure = list(
      allocation = disclosure_metrics(
        post_allocation, dat$A, g
      ),
      outcome = disclosure_metrics(
        post_outcome, dat$A, g
      ),
      W_only = disclosure_metrics(
        post_W, dat$A, g
      )
    ),
    condition_max = max(dat$condition),
    outcome_recovery_error = max(
      abs(rowSums(dat$W) - dat$Y)
    )
  )
}

summarize_scenario <- function(
  n,
  scenario,
  means,
  epsilon,
  B,
  r,
  attacker,
  criteria,
  contrast
) {
  runs <- replicate(
    B,
    one_trial(
      n = n,
      means = means,
      epsilon = epsilon,
      r = r,
      attacker = attacker,
      contrast = contrast
    ),
    simplify = FALSE
  )

  theta <- sum(contrast * means)

  base <- data.frame(
    n = n,
    scenario = scenario,
    epsilon = epsilon
  )

  extract_analysis <- function(name, field) {
    vapply(
      runs,
      function(x) x[[name]][[field]],
      numeric(1)
    )
  }

  original <- extract_analysis(
    "original", "estimate"
  )

  released <- extract_analysis(
    "released", "estimate"
  )

  variance_ratio <- var(released) / var(original)

  utility <- do.call(
    rbind,
    lapply(
      c("original", "released"),
      function(name) {
        estimates <- extract_analysis(
          name, "estimate"
        )

        se <- extract_analysis(name, "se")

        data.frame(
          base,
          analysis = name,
          bias = mean(estimates - theta),
          empirical_sd = sd(estimates),
          mean_se = mean(se),
          coverage = mean(
            abs(estimates - theta) <=
              qnorm(0.975) * se
          ),
          rejection = mean(
            extract_analysis(name, "reject")
          ),
          variance_ratio = if (
            name == "released"
          ) {
            variance_ratio
          } else {
            1
          },
          paired_difference_sd = if (
            name == "released"
          ) {
            sd(released - original)
          } else {
            0
          }
        )
      }
    )
  )

  information_sets <- c(
    "allocation",
    "outcome",
    "W_only"
  )

  metric_names <- c(
    "accuracy",
    "logloss",
    "brier",
    "high80",
    "high95"
  )

  disclosure <- do.call(
    rbind,
    lapply(
      information_sets,
      function(info) {
        averages <- sapply(
          metric_names,
          function(metric) {
            mean(
              vapply(
                runs,
                function(x) {
                  x$disclosure[[info]][[metric]]
                },
                numeric(1)
              )
            )
          }
        )

        data.frame(
          base,
          information = info,
          as.list(averages),
          row.names = NULL
        )
      }
    )
  )

  released_row <- utility[
    utility$analysis == "released",
    ,
    drop = FALSE
  ]

  W_row <- disclosure[
    disclosure$information == "W_only",
    ,
    drop = FALSE
  ]

  joint <- data.frame(
    base,
    variance_ratio = released_row$variance_ratio,
    coverage = released_row$coverage,
    W_accuracy = W_row$accuracy,
    W_high95 = W_row$high95,
    max_condition_number = max(
      vapply(
        runs,
        `[[`,
        numeric(1),
        "condition_max"
      )
    ),
    max_outcome_recovery_error = max(
      vapply(
        runs,
        `[[`,
        numeric(1),
        "outcome_recovery_error"
      )
    )
  )

  joint$passes_utility <-
    joint$variance_ratio <=
      criteria$max_variance_ratio &
    joint$coverage >=
      criteria$min_coverage

  joint$passes_confidentiality <-
    joint$W_accuracy <=
      criteria$max_W_accuracy &
    joint$W_high95 <=
      criteria$max_W_high95

  joint$passes_both <-
    joint$passes_utility &
    joint$passes_confidentiality

  list(
    utility = utility,
    disclosure = disclosure,
    joint = joint
  )
}

run_simulation <- function(
  B = 2000L,
  sizes = c(300L, 1000L),
  n_train = 10000L,
  criteria = simulation_criteria
) {
  stopifnot(
    B >= 2L,
    all(sizes > 5L),
    n_train > 100L
  )

  scenarios <- list(
    null = c(0, 0, 0),
    small = c(0, 0.25, 0.50),
    large = c(0, 0.50, 1.00)
  )

  epsilons <- c(
    0,
    0.05,
    0.15,
    0.30,
    0.50
  )

  grid <- expand.grid(
    n = sizes,
    scenario = names(scenarios),
    epsilon = epsilons,
    KEEP.OUT.ATTRS = FALSE,
    stringsAsFactors = FALSE
  )

  # Train once per outcome scenario and epsilon.
  attackers <- list()

  for (scenario in names(scenarios)) {
    for (epsilon in epsilons) {
      key <- paste(
        scenario,
        epsilon,
        sep = "_"
      )

      message(
        "Training W-only attacker: ",
        key
      )

      attackers[[key]] <- train_W_attacker(
        means = scenarios[[scenario]],
        epsilon = epsilon,
        r = r,
        n_train = n_train
      )
    }
  }

  results <- lapply(
    seq_len(nrow(grid)),
    function(j) {
      cfg <- grid[j, ]

      key <- paste(
        cfg$scenario,
        cfg$epsilon,
        sep = "_"
      )

      message(
        sprintf(
          "%d/%d: n=%d, scenario=%s, epsilon=%.2f",
          j,
          nrow(grid),
          cfg$n,
          cfg$scenario,
          cfg$epsilon
        )
      )

      summarize_scenario(
        n = cfg$n,
        scenario = cfg$scenario,
        means = scenarios[[cfg$scenario]],
        epsilon = cfg$epsilon,
        B = B,
        r = r,
        attacker = attackers[[key]],
        criteria = criteria,
        contrast = contrast
      )
    }
  )

  outputs <- list(
    utility = do.call(
      rbind,
      lapply(results, `[[`, "utility")
    ),
    disclosure = do.call(
      rbind,
      lapply(results, `[[`, "disclosure")
    ),
    joint_decision = do.call(
      rbind,
      lapply(results, `[[`, "joint")
    )
  )

  for (name in names(outputs)) {
    rownames(outputs[[name]]) <- NULL

    write.csv(
      outputs[[name]],
      file = paste0(
        "simulation_",
        name,
        ".csv"
      ),
      row.names = FALSE
    )
  }

  invisible(outputs)
}

